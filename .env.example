# ============================================
# Milton International College - Vercel Env
# ============================================
# Copy this to .env.local for local dev
# Set these in Vercel Dashboard > Settings > Environment Variables

# --- Database (Required) ---
# Get a free PostgreSQL database from https://supabase.com
# Use pooled URL (port 6543) for the app at runtime
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:6543/postgres?schema=public"
# Use direct URL (port 5432) for migrations / prisma db push / seed
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres?schema=public"

# --- NextAuth (Required) ---
NEXTAUTH_URL="https://YOUR_PROJECT.vercel.app"  # Change to your Vercel URL
NEXTAUTH_SECRET="generate-a-random-secret-here" # Run: openssl rand -base64 32

# --- Optional: Payment Gateway ---
# KHALTI_SECRET_KEY=your-khalti-secret-key
# ESEWA_SECRET_KEY=your-esewa-secret-key

# --- Optional: Cloud Storage for images ---
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Optional: Google Maps ---
# NEXT_PUBLIC_GMAPS_API_KEY=your-google-maps-api-key
